# Groq API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: GitHub Personal Access Token (increases rate limit from 60 to 5,000 req/hr)
# Create a free classic token with public_repo or fine-grained read-only permissions at https://github.com/settings/tokens
GITHUB_TOKEN=

# Default Groq model (recommended: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Server configuration
PORT=8000
HOST=127.0.0.1
